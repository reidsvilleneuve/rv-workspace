#!/bin/zsh

source RVDEVREPLACE_projectdir/variables/git-variables.sh

changed_files="$(git diff --name-only "${(q)RVDEVREPLACE_prefix_git_base}" HEAD)"

echo "Eslint: Files changed from ${(q)RVDEVREPLACE_prefix_git_base}:\n$changed_files\n"

xargs ./node_modules/.bin/eslint --fix <<< "$changed_files"
